# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: limit slash commands to one guild for instant sync during development.
# Leave empty to register globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Optional: Discord channel id where the bot escalates questions it can't answer.
STAFF_CHANNEL_ID=
# Optional: role id pinged in the staff channel on escalation (e.g. @admin).
ADMIN_ROLE_ID=
# Optional: Discord channel id where the bot mirrors all activity (boot, queries, errors).
BOT_LOG_CHANNEL_ID=

# Optional: comma-separated channel IDs where /ask is allowed.
# Empty = unrestricted. The authoritative way to hide /ask from other channels
# is Server Settings → Integrations → bot → /ask → Channels; this env var is a
# fallback guard for users who somehow still invoke it elsewhere.
ASK_CHANNEL_IDS=

# --- 42 API (for /search) ------------------------------------------------
# Register an OAuth app at https://profile.intra.42.fr/oauth/applications
# (any 42 student account works). Scope `public` is sufficient.
# Without these, /search returns a friendly "not configured" message.
FORTYTWO_UID=
FORTYTWO_SECRET=
# Numeric campus ID — Tokyo = 26. If a student's active session is at a
# different campus, /search still answers but flags the mismatch.
FORTYTWO_CAMPUS_ID=26

# --- LLM provider auto-detection -----------------------------------------
# Order: GEMINI_API_KEY → GROQ_API_KEY → Ollama (local).
# Override with LLM_PROVIDER=gemini|groq|ollama to force a specific path.
# Used at both ingest and query time.
LLM_PROVIDER=auto

# --- Gemini (recommended free path) --------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Free tier on gemini-2.5-flash-lite: 15 RPM, 1000 RPD. Plenty for the bot.
# (gemini-1.5-flash is retired; gemini-2.0-flash has no free quota; 2.5-flash
#  uses thinking tokens that can clip short responses — lite is the safe pick.)
# Solid Japanese quality; uses Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT=120
GEMINI_MAX_ASYNC=1

# --- Groq (paid Dev tier recommended) ------------------------------------
# Free tier's 6K TPM cap is below LightRAG's prompt size; ingest will fail.
# Paid Dev tier (~$3 for full ingest) lifts the cap.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60
GROQ_MAX_ASYNC=8

# --- Ollama (local fallback) ---------------------------------------------
# Used when no API key is set, or LLM_PROVIDER=ollama. No rate limits but
# slow on a Mac (~5-7h for the full corpus).
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=300
LLM_MAX_ASYNC=2

# --- Embeddings + LightRAG storage ---------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LIGHTRAG_WORKING_DIR=./rag_storage

# Query mode. Options: naive | local | global | hybrid | mix
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_TOP_K=20

CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP=100
