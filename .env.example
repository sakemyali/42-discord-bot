# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: limit slash commands to one guild for instant sync during development.
# Leave empty to register globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Optional: Groq API key from https://console.groq.com/keys
# If set, the bot uses Groq to phrase answers. If empty, the bot returns the
# top-matching corpus chunks verbatim.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: where the staff escalation channel is (Discord channel id).
# When the bot can't answer with confidence, it posts there.
STAFF_CHANNEL_ID=

# Embedding model. all-MiniLM-L6-v2 is small (~80MB), fast on CPU, English-only.
# For multilingual swap to: paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Similarity threshold below which the bot escalates instead of answering.
# Cosine similarity range is [-1, 1]; for MiniLM-style models 0.35-0.5 is reasonable.
MIN_SIMILARITY=0.35
