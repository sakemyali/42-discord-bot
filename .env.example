# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: limit slash commands to one guild for instant sync during development.
# Leave empty to register globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Optional: Discord channel id where the bot posts when a query throws.
STAFF_CHANNEL_ID=

# --- Groq (ingest fast path) ---------------------------------------------
# If GROQ_API_KEY is set, ingest uses Groq's free tier instead of Ollama.
# ~10x faster ingest. Get a free key at https://console.groq.com/keys
# Queries always use Ollama (private, runs offline). Override the auto-pick
# by setting INGEST_LLM=ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60
GROQ_MAX_ASYNC=8
INGEST_LLM=auto

# --- Ollama (query path, default for everything if Groq is empty) --------
# qwen2.5:7b — strong Japanese, ~4.7GB.
# Lower-memory option: ministral-3:3b-instruct-2512-q4_K_M (~3GB).
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=300
LLM_MAX_ASYNC=2

# --- Embeddings + LightRAG storage ---------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LIGHTRAG_WORKING_DIR=./rag_storage

# Query mode. Options: naive | local | global | hybrid | mix
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=20

CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP=100
